# ============================================================
# GINI-ORACLE-1 — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- App ---
APP_NAME=GINI-AI
APP_ENV=development        # development | staging | production
APP_VERSION=1.0.0
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- AI / LLM ---
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
DEFAULT_LLM_PROVIDER=anthropic   # openai | anthropic

# --- Voice ---
VOICE_ENABLED=true
VOICE_LANGUAGE=en-IN

# --- Emotion Engine ---
EMOTION_ENGINE_ENABLED=true
EMOTION_SENSITIVITY=high         # low | medium | high

# --- Device Control ---
DEVICE_CONTROL_ENABLED=true
SMART_HOME_ENABLED=true
HOSPITAL_MODULE_ENABLED=true
VEHICLE_MODULE_ENABLED=true
MOBILE_MODULE_ENABLED=true

# --- Logging ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_TO_FILE=true
LOG_FILE_PATH=logs/gini.log

# --- Database (future) ---
DATABASE_URL=sqlite:///gini.db

# --- Security ---
SECRET_KEY=change_this_to_a_strong_secret_key
